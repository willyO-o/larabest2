{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LARABEST",
  "version": "0.1.1",
  "identifier": "com.soglotec.larabest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LARABEST",
        "width": 700,
        "height": 380,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SOGLOTEC",
    "copyright": "© 2026 SOGLOTEC. Uso educativo gratuito.",
    "category": "DeveloperTool",
    "shortDescription": "Servidor local para aprender y desarrollar con PHP",
    "longDescription": "LARABEST instala y administra Apache o Nginx, PHP y MariaDB en tu equipo para crear sitios WordPress y Laravel de práctica.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  }
}
