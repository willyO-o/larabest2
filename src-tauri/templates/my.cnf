# Generado por {{ app_name }} para MariaDB {{ version }}. No editar: se regenera en cada inicio.

[mysqld]
basedir = "{{ basedir }}"
datadir = "{{ datadir }}"
port = {{ port }}
bind-address = 127.0.0.1
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
log-error = "{{ logs }}/mariadb-error.log"
pid-file = "{{ tmp }}/mariadb.pid"

[client]
host = 127.0.0.1
port = {{ port }}
default-character-set = utf8mb4

# Ajustes propios: archivos .cnf en esta carpeta (no se regeneran).
!includedir {{ custom_dir }}
